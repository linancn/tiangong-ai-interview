{
  "name": "tiangong-interview",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3001",
    "lint": "eslint",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:db": "docker compose up -d postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart tiangong-interview --update-env",
    "pm2:stop": "pm2 stop tiangong-interview",
    "pm2:delete": "pm2 delete tiangong-interview",
    "pm2:logs": "pm2 logs tiangong-interview",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.63",
    "@ai-sdk/react": "3.0.184",
    "@assistant-ui/react": "0.14.5",
    "@assistant-ui/react-ai-sdk": "1.3.26",
    "@assistant-ui/react-markdown": "0.14.0",
    "@base-ui/react": "1.4.1",
    "ai": "6.0.182",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.14.0",
    "nanoid": "5.1.11",
    "next": "16.2.6",
    "pm2": "7.0.1",
    "postgres": "3.4.9",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remark-gfm": "4.0.1",
    "shadcn": "4.7.0",
    "smol-toml": "1.6.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.11",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "20.19.41",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  }
